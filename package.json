{
  "name": "yeongdu-memo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.3 <25"
  },
  "scripts": {
    "mobile": "pnpm --filter @yeongdu/mobile start",
    "android": "pnpm --filter @yeongdu/mobile android",
    "apk": "pnpm --filter @yeongdu/mobile apk",
    "apk:debug": "pnpm --filter @yeongdu/mobile apk:debug",
    "ios": "pnpm --filter @yeongdu/mobile ios",
    "server": "pnpm --filter @yeongdu/server dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "pnpm check-types && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@yeongdu/shared": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
