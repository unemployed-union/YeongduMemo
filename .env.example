# Local server path is relative to apps/server when using pnpm server.
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/memo.db
# Comma-separated trusted reverse-proxy IPs/CIDRs. Empty = no trust.
TRUST_PROXY=
# Encrypted attachments: filesystem (default) or s3.
ATTACHMENT_STORAGE=filesystem
# Default: attachments beside DATABASE_PATH. Docker: /data/attachments.
# ATTACHMENT_PATH=./data/attachments
# Includes staged uploads; default 1 GiB per user, 20 MiB per file.
ATTACHMENT_QUOTA_BYTES=1073741824
# S3-compatible private bucket; create it before starting the server.
# S3_BUCKET=private-memo
S3_REGION=us-east-1
# Leave unset for AWS S3. For MinIO, e.g. https://minio.example.com
# S3_ENDPOINT=https://s3.example.com
S3_PREFIX=yeongdu-memo
S3_FORCE_PATH_STYLE=false
# Standard AWS credential chain is used. Never bake credentials into images.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Docker Compose binds only loopback by default.
MEMO_PORT=3000
# Optional published image. Build locally when unset.
# MEMO_IMAGE=ghcr.io/your-owner/yeongdu-memo:latest
