+package com.expensify.livemarkdown.spans;
+
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.text.style.ReplacementSpan;
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+/** Hides formatting delimiters without mutating text, offsets, selection or composing spans. */
+public class MarkdownHiddenSyntaxSpan extends ReplacementSpan implements MarkdownSpan {
+  @Override
+  public int getSize(@NonNull Paint paint, CharSequence text, int start, int end,
+      @Nullable Paint.FontMetricsInt metrics) {
+    return 0;
+  }
+
+  @Override
+  public void draw(@NonNull Canvas canvas, CharSequence text, int start, int end,
+      float x, int top, int y, int bottom, @NonNull Paint paint) {
+    // Delimiters stay in the source but occupy no painted space.
+  }
+}
